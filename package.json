{
  "name": "@carecard/jwt-read",
  "version": "3.12.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CareCard-ca/pkg-jwt-read.git"
  },
  "description": "Jwt read functions",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "npm run test:order && mocha --require ./scripts/testOrder/randomizeTestOrder.cjs --recursive",
    "test:order": "node --test scripts/testOrder/randomizeTestOrder.test.mjs scripts/testOrder/testOrderPolicy.test.mjs",
    "test:types": "npm run test:order && tsc --noEmit && mocha --require ./scripts/testOrder/randomizeTestOrder.cjs -r ts-node/register test/types.test.ts",
    "test:coverage": "npm run test:order && tsc --noEmit && nyc mocha --require ./scripts/testOrder/randomizeTestOrder.cjs --recursive -r ts-node/register 'test/**/*.{js,ts}'",
    "test:All": "npm run test && npm run test:types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "lint:fix": "eslint --fix",
    "lint": "eslint"
  },
  "keywords": [
    "auth",
    "utility",
    "cryptology",
    "jwt"
  ],
  "author": "CareCard team",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "25.9.3",
    "eslint": "9.39.4",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "mocha": "11.7.6",
    "nyc": "18.0.0",
    "prettier": "3.8.4",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@carecard/auth-util": "3.12.0",
    "@carecard/common-util": "3.12.0",
    "@carecard/validate": "3.12.0"
  },
  "overrides": {
    "diff": "8.0.4",
    "serialize-javascript": "7.0.5",
    "js-yaml": "4.2.0"
  }
}
